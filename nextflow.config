// Site-specific Slurm routing is overridable via the environment so this config
// is not tied to one cluster. Defaults reproduce the committed ISAAC-NG values.
//   HPC_PARTITION  Slurm partition for Nextflow child jobs (default: campus)
//   HPC_QOS        Slurm QoS for Nextflow child jobs        (default: campus)
// See "Partition and QoS overrides" in RUN_COMMANDS.md. The #SBATCH lines in
// submit_*.sh cannot read these (Slurm parses them before any shell runs), so
// pass matching -p/-q flags to sbatch for the manager job.
params {
    account = System.getenv('ISAAC_ACCOUNT') ?: ''
    partition = System.getenv('HPC_PARTITION') ?: 'campus'
    qos = System.getenv('HPC_QOS') ?: 'campus'
    container_cache = System.getenv('CONTAINER_CACHE') ?: (System.getenv('SCRATCHDIR') ? "${System.getenv('SCRATCHDIR')}/veeev_nat_hist_nfcore/containers" : '')
}

process {
    executor = 'slurm'
    queue = params.partition
    clusterOptions = params.account ? "--account=${params.account} --qos=${params.qos}" : "--qos=${params.qos}"

    withName: /.*STAR_ALIGN.*/ {
        cpus = 14
        memory = '45 GB'
        time = '16h'
    }

    withName: /.*STAR_GENOMEGENERATE.*/ {
        cpus = 14
        memory = '96 GB'
        time = '16h'
    }

    withName: /.*SALMON_QUANT.*/ {
        cpus = 8
        memory = '48 GB'
        time = '4h'
    }

    withName: /.*SALMON_INDEX.*/ {
        cpus = 8
        memory = '48 GB'
        time = '4h'
    }
}

executor {
    // Increased from 20 to 48. Rationale (untested estimate, not a measurement):
    // the QC tasks (RSEQC, QUALIMAP) are single-threaded and dominate wall time,
    // so raising concurrency to match a 48-core node should keep it saturated
    // through the QC phase. No completed before/after run has been recorded in
    // this repo, so treat any speedup figure as unverified.
    queueSize = 48
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = params.container_cache
}
