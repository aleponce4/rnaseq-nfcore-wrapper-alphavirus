# Central runtime settings for submit_rnaseq.sh.
#
# This file stores the settings that commonly change between runs.
# The Slurm manager job resources still live in submit_rnaseq.sh under the
# #SBATCH lines because Slurm reads those before this file can be sourced.

# Required for Nextflow child jobs on ISAAC-NG.
export ISAAC_ACCOUNT="${ISAAC_ACCOUNT:-ACF-UTKXXXX}"

# Recommended so `sbatch submit_rnaseq.sh <dataset>` charges the manager job
# to the same account. Exported here for convenience.
export SBATCH_ACCOUNT="${SBATCH_ACCOUNT:-$ISAAC_ACCOUNT}"

# Slurm partition/QoS for the Nextflow child jobs (read by nextflow.config).
# Defaults reproduce the values in the submit_*.sh #SBATCH lines. Slurm parses
# those directives before this file is sourced, so changing these does NOT move
# the manager job -- pass matching -p/-q/--time flags to sbatch as well.
export HPC_PARTITION="${HPC_PARTITION:-campus}"
export HPC_QOS="${HPC_QOS:-campus}"

# Runtime bootstrap on ISAAC-NG.
# The cluster default `nextflow` module resolves to an old launcher, so the
# known-good path is:
#   1. load Java 17
#   2. put a user-managed Nextflow launcher on PATH (for example ~/bin/nextflow)
#   3. set NXF_VER=25.04.3
#
# If NEXTFLOW_BIN_DIR contains an executable named `nextflow`, submit_rnaseq.sh
# will prepend it to PATH and you can use SKIP_MODULE_LOAD=1. Otherwise the
# script falls back to loading NEXTFLOW_MODULE.
export JAVA_MODULE="${JAVA_MODULE:-openjdk/17.0.0_35}"
export NEXTFLOW_BIN_DIR="${NEXTFLOW_BIN_DIR:-${HOME:+$HOME/bin}}"
export NXF_VER="${NXF_VER:-25.04.3}"

# Module names on ISAAC-NG. Change these if `module avail` shows different names.
# Leave NEXTFLOW_MODULE empty when using NEXTFLOW_BIN_DIR + SKIP_MODULE_LOAD=1.
# Leave CONTAINER_MODULE empty if `singularity` is already available on PATH.
export NEXTFLOW_MODULE="${NEXTFLOW_MODULE:-nextflow}"
export CONTAINER_MODULE="${CONTAINER_MODULE:-}"

# nf-core profile for container execution on the cluster.
export NFCORE_PROFILE="${NFCORE_PROFILE:-singularity}"

# Samplesheet defaults.
export DEFAULT_STRANDEDNESS="${DEFAULT_STRANDEDNESS:-auto}"

# Optional dataset-specific viral reference directory overrides under references/.
# Example: set MOUSE_VEEV_VIRUS_REF=VEEV_INH to use references/VEEV_INH/ for mouse_veev
# while leaving rat_veev on references/VEEV/.
export MOUSE_VEEV_VIRUS_REF="${MOUSE_VEEV_VIRUS_REF:-VEEV}"
export MOUSE_EEEV_VIRUS_REF="${MOUSE_EEEV_VIRUS_REF:-EEEV}"
export RAT_VEEV_VIRUS_REF="${RAT_VEEV_VIRUS_REF:-VEEV}"

# Scratch-backed runtime locations.
# Paths stay empty until SCRATCHDIR is available; submit_rnaseq.sh enforces it for real runs.
export RESULTS_BASE="${RESULTS_BASE:-${SCRATCHDIR:+$SCRATCHDIR/veeev_nat_hist_nfcore/results}}"
export WORK_ROOT="${WORK_ROOT:-${SCRATCHDIR:+$SCRATCHDIR/veeev_nat_hist_nfcore/work}}"
export RESULTS_BASE_SMOKE="${RESULTS_BASE_SMOKE:-${SCRATCHDIR:+$SCRATCHDIR/veeev_nat_hist_nfcore/results_smoke}}"
export WORK_ROOT_SMOKE="${WORK_ROOT_SMOKE:-${SCRATCHDIR:+$SCRATCHDIR/veeev_nat_hist_nfcore/work_smoke}}"
export CONTAINER_CACHE="${CONTAINER_CACHE:-${SCRATCHDIR:+$SCRATCHDIR/veeev_nat_hist_nfcore/containers}}"
export NXF_HOME="${NXF_HOME:-${SCRATCHDIR:+$SCRATCHDIR/veeev_nat_hist_nfcore/.nextflow}}"

# Viral gene_id values are set automatically from the selected virus name.
